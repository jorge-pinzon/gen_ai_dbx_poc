# Prod settings for the Flask app (mariner_genai_dbx). No secrets in this file.
# On Databricks Apps, put these under `env:` in app.yaml; the platform injects the
# app service principal's credentials (do not set DATABRICKS_TOKEN or a client secret).
# <...> values come from notebook 06 (endpoint names) and the prod workspace.

APP_ENV=production
APP_VERSION=1.1.0
AUTH_MODE=databricks
SUPERVISOR_MODE=databricks
# INFO in prod: DEBUG logs every raw stream line and is slower.
LOG_LEVEL=INFO

DATABRICKS_HOST=https://<prod-workspace>.cloud.databricks.com
DATABRICKS_SUPERVISOR_ENDPOINT=<mas-...-endpoint from notebook 06>
DATABRICKS_WAREHOUSE_ID=<prod serverless warehouse id>
DATABRICKS_LOG_TABLE=workspace.default.flask_app_logs

DATABRICKS_CITATION_REGISTRY_TABLE=workspace.default.app_citation_registry
CITATION_REGISTRY_TTL_SECONDS=60
CITATION_REGISTRY_TIMEOUT_SECONDS=10

# Slash commands call their specialist directly (1.6-6.7x faster than through the Supervisor).
# Paste the line printed by notebook 06. /benefits uses the benefits Knowledge Assistant.
DIRECT_SPECIALIST_ROUTES_JSON={"/policy":{"endpoint":"<ka-policy-endpoint>","api":"responses","agent":"mariner-policy-assistant"},"/handbook":{"endpoint":"<ka-handbook-endpoint>","api":"responses","agent":"mariner-handbook-assistant"},"/benefits":{"endpoint":"<ka-benefits-endpoint>","api":"responses","agent":"mariner-benefits-assistant"},"/performance":{"endpoint":"perf-policy-citations","api":"responses","agent":"endpoint-perf-policy-citations"}}

# The performance fast path reads employee data with the app identity, so the app refuses it in
# production. Keep it off until per-manager access scoping exists.
PERFORMANCE_FAST_PATH_ENABLED=false
PERFORMANCE_FAST_MODEL_ENDPOINT=databricks-gpt-5-4-mini
PERFORMANCE_SYNTHESIS_MODEL_ENDPOINT=databricks-gpt-5-4-mini
PERFORMANCE_VIEW_PREFIX=app_fast_

# Speed settings from the performance work (see the guide, section 8).
REQUEST_TIMEOUT_SECONDS=180
GUNICORN_TIMEOUT_SECONDS=180
WEB_CONCURRENCY=2
WEB_THREADS=16

MAX_MESSAGE_CHARACTERS=4000
CHAT_HISTORY_LIMIT=20
CHAT_SESSION_TTL_SECONDS=1800
SOURCE_URL_TTL_SECONDS=300
SESSION_SECRET_KEY=<at least 32 random characters, stored as an app secret>

# Per-stage timings in flask_app_logs.stage_timings_json (column created by sql/06_app_tables.sql).
ANALYTICS_STAGE_TIMINGS=true

# Coaching360 (/coaching360): needs notebooks 02 (coaching360demo), 02b (c360_* views) and 06 (Genie spaces,
# guide, Supervisor tools). Keep it off until the shared demo persona is replaced (guide, section 11):
# any user can pick any person, and all users share the service principal's user_map row.
COACHING360_ENABLED=false
# Coaching360 answers stop after this many seconds; keep it at or below GUNICORN_TIMEOUT_SECONDS.
COACHING360_TIMEOUT_SECONDS=120

VOLUME_CATALOGS_JSON=[{"id":"branch-operations","label":"Branch Operations","volumePath":"/Volumes/workspace/default/branch_operations_docs"},{"id":"employee-handbook","label":"Employee Handbook","volumePath":"/Volumes/workspace/default/employee_handbook_docs"},{"id":"employee-benefits","label":"Employee Benefits","volumePath":"/Volumes/workspace/default/benefits_docs"},{"id":"performance-policy","label":"Employee Performance Policy","volumePath":"/Volumes/workspace/performance_test/data"},{"id":"coaching360","label":"Coaching360","volumePath":"/Volumes/workspace/coaching360demo/coaching360_docs"}]
