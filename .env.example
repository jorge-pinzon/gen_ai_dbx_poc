# Local development starts without external calls.
APP_ENV=development
APP_VERSION=development
AUTH_MODE=local
SUPERVISOR_MODE=mock
LOG_LEVEL=INFO

# Required only when AUTH_MODE=password. Store a Werkzeug password hash, never
# a plaintext password. SESSION_SECRET_KEY must contain at least 32 characters.
LOGIN_USERNAME=
LOGIN_PASSWORD_HASH=

# Required when SUPERVISOR_MODE=databricks.
DATABRICKS_HOST=https://dbc-957e994b-63c5.cloud.databricks.com
DATABRICKS_CLIENT_ID=9480056c-9708-40af-92da-c35b15cf61fa
DATABRICKS_CLIENT_SECRET=
DATABRICKS_SUPERVISOR_ENDPOINT=mas-53dbd2d7-endpoint
DATABRICKS_WAREHOUSE_ID=55cdb78d4d2a62d0
DATABRICKS_LOG_TABLE=workspace.default.flask_app_logs

# Enable only after running sql/create_citation_registry.sql and updating retrieval
# and Supervisor output using agent_descriptions/structured_citations.md.
DATABRICKS_CITATION_REGISTRY_TABLE=
CITATION_REGISTRY_TTL_SECONDS=60
CITATION_REGISTRY_TIMEOUT_SECONDS=10

# Optional POC-only performance route, using the app identity's UC visibility.
# Other specialists retain the existing Supervisor path.
PERFORMANCE_FAST_PATH_ENABLED=false
PERFORMANCE_FAST_MODEL_ENDPOINT=databricks-gpt-5-4-mini
PERFORMANCE_SYNTHESIS_MODEL_ENDPOINT=databricks-gpt-5-4-mini
# app_vw_ (live views) or app_fast_ (after running sql/create_performance_fast_views.sql)
PERFORMANCE_VIEW_PREFIX=app_vw_

# Local development only. Production must use Databricks workload identity.
DATABRICKS_TOKEN=

REQUEST_TIMEOUT_SECONDS=60
MAX_MESSAGE_CHARACTERS=4000
CHAT_HISTORY_LIMIT=20
CHAT_SESSION_TTL_SECONDS=1800
SOURCE_URL_TTL_SECONDS=300
SESSION_SECRET_KEY=

# Approved Unity Catalog Volume roots. Source operations remain disabled until
# the new workspace contract is implemented.
VOLUME_CATALOGS_JSON=[{"id":"branch-operations","label":"Branch Operations","volumePath":"/Volumes/workspace/default/branch_operations_docs"},{"id":"employee-handbook","label":"Employee Handbook","volumePath":"/Volumes/workspace/default/employee_handbook_docs"},{"id":"employee-benefits","label":"Employee Benefits","volumePath":"/Volumes/workspace/default/benefits_docs"},{"id":"performance-policy","label":"Employee Performance Policy","volumePath":"/Volumes/workspace/performance_test/data"}]

# Optional: answer slash commands from their specialist endpoint without the
# Supervisor hops. Unlisted commands, chart requests and failed calls use the
# Supervisor. api is "responses" (Knowledge Assistants, Responses agents) or "chat".
DIRECT_SPECIALIST_ROUTES_JSON={}

# Coaching360 demo flow (/coaching360); requires coaching360/notebooks/setup_agents.py first.
COACHING360_ENABLED=false

# Per-stage timings in the analytics log (stage_timings_json). Run the second statement in
# sql/add_flask_app_logs_stage_timings.sql first; the column must exist before this is true.
ANALYTICS_STAGE_TIMINGS=false
